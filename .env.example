# ==============================================================================
# MediaFlow Bot — environment configuration
# Copy this file to .env and fill in the values. Never commit real secrets.
# ==============================================================================

# --- Database (required) ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- Telegram (required to run the bot) ---
BOT_TOKEN=
# Secret Telegram will echo back in every webhook request header so we can
# reject spoofed requests. Generate any long random string.
WEBHOOK_SECRET=
# Public HTTPS base URL of this deployment, used by /api/telegram/setup to
# register the webhook (e.g. https://your-domain.com).
PUBLIC_BASE_URL=
# Comma-separated Telegram user IDs that are allowed to use /admin.
ADMIN_IDS=

# --- Cache / Queue (optional — falls back to safe in-memory implementations) ---
REDIS_URL=

# --- Music recognition provider (AudD — https://audd.io) ---
MUSIC_PROVIDER=audd
MUSIC_API_KEY=
MUSIC_API_BASE_URL=https://api.audd.io/
RECOGNITION_SAMPLE_SECONDS=12
RECOGNITION_MAX_ATTEMPTS=3

# --- YouTube search ---
# "ytdlp" (default, no key required) or "api" (uses YouTube Data API v3)
YOUTUBE_SEARCH_PROVIDER=ytdlp
YOUTUBE_API_KEY=
YOUTUBE_SEARCH_CACHE_TTL=600

# --- Object storage (optional, for future horizontal scaling) ---
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=auto

# --- Limits ---
MAX_FILE_SIZE=52428800
MAX_VIDEO_DURATION=1200
MAX_GLOBAL_DOWNLOADS=5
MAX_USER_DOWNLOADS=2
MAX_REQUESTS_PER_MINUTE=10
MAX_DOWNLOADS_PER_DAY=60
MAX_RETRIES=3

# --- Storage lifecycle ---
TEMP_DIR=/tmp/mediaflow
TEMP_FILE_TTL_MINUTES=30

# --- Observability ---
LOG_LEVEL=info
